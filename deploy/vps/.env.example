# Copie para /opt/titasbot/.env no servidor e preencha.
# Este arquivo guarda segredos: nunca comite o .env preenchido.

# Chave da OpenAI usada pelo chat e pelos embeddings do banco vetorial.
OPENAI_API_KEY=sk-...

# Endereco publico atendido pelo Caddy.
#   - com dominio: titasbot.exemplo.com.br  (HTTPS automatico)
#   - sem dominio: :80                      (so HTTP, acesso pelo IP)
SITE_ADDRESS=:80

# Imagem publicada pelo GitHub Actions. Troque a tag por um SHA para fixar
# uma versao especifica (rollback).
TITASBOT_IMAGE=ghcr.io/vctorpego/titasbot:latest

# Modelo de producao. gpt-5-nano e o mais barato; gpt-5-mini responde melhor.
OPENAI_CHAT_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHAT_TEMPERATURE=0
