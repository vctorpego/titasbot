# Copie para /opt/titasbot/.env no servidor e preencha.
# Este arquivo guarda segredos: nunca comite o .env preenchido.

# Chave da OpenAI usada pelo chat e pelos embeddings do banco vetorial.
OPENAI_API_KEY=sk-...

# Endereco publico atendido pelo Caddy.
# O hostname que a Locaweb entrega ja resolve publicamente, entao o Let's
# Encrypt emite certificado para ele -- nao foi preciso comprar dominio.
#   - com dominio: titasbot.exemplo.com.br  (HTTPS automatico)
#   - sem dominio: :80                      (so HTTP, acesso pelo IP)
SITE_ADDRESS=vps73870.publiccloud.com.br

# Imagem publicada pelo GitHub Actions. Troque a tag por um SHA para fixar
# uma versao especifica (rollback).
TITASBOT_IMAGE=ghcr.io/vctorpego/titasbot:latest

# Modelo de producao. Medido em 2026-11-11 nas mesmas perguntas: gpt-5-nano e
# gpt-5-mini levam o mesmo tempo (~80 s nas perguntas de lista, porque o custo
# esta nas varias chamadas encadeadas do pipeline, nao no modelo), mas o nano
# erra mais -- chegou a listar "Pratica" e "Teorica" como tecnologias.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHAT_TEMPERATURE=0
