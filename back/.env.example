# ============================================================
# Chaves de API — NAO comitar valores reais.
# Se uma chave real for commitada, ROTACIONE/REVOGUE imediatamente.
# ============================================================
OPENAI_API_KEY=sk-your-openai-key-here
# Necessarias para a avaliacao comparativa multi-provedor (scripts/evaluate_models.py):
ANTHROPIC_API_KEY=your-anthropic-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
# ^ DeepSeek exige saldo PRE-PAGO em platform.deepseek.com (sem tier gratuito).
# GOOGLE_API_KEY=your-google-ai-studio-key-here
# ^ nao usada -- Gemini foi testado como avaliador do DeepEval mas o
# tier gratuito (15 requisicoes/minuto) e impraticavel para o volume desta
# avaliacao; ver DEEPEVAL_EVAL_PROVIDER abaixo.

# ============================================================
# Base de conhecimento / indice vetorial
# ============================================================
BASE_DIR=./base
# CHROMA_DB_PATH=C:\path\to\chatbot_chroma_db
CHROMA_COLLECTION=titas_docs

# ============================================================
# Modelo de chat de PRODUCAO (o chatbot em si)
# CHAT_PROVIDER vazio => provedor inferido pelo nome do modelo
# (gpt-/o1- => openai, claude- => anthropic, gemini- => google_genai).
# ============================================================
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHAT_TEMPERATURE=0
# CHAT_PROVIDER=

# ============================================================
# Avaliacao comparativa de modelos (scripts/evaluate_models.py)
# Confirme os IDs atuais de cada provedor antes da rodada avaliada.
# ============================================================
# EVAL_OPENAI_MODEL=gpt-5
# EVAL_ANTHROPIC_MODEL=claude-sonnet-5
# EVAL_DEEPSEEK_MODEL=deepseek-v4-pro
# EVAL_GOOGLE_MODEL=gemini-2.0-flash   # nao usado -- Gemini removido da comparacao
# EVAL_CONDITIONS=rag,no_rag
# MODEL_EVAL_METRIC_SET=full        # fast | standard | full (novo default: full)
# REF_SEMANTIC_WEIGHT=0.8
# REF_LEXICAL_WEIGHT=0.2

# ============================================================
# Avaliador do DeepEval -- um modelo diferente dos 3 comparados, para reduzir
# autoavaliacao. Gemini (independencia total de provedor) foi tentado
# primeiro, mas o tier gratuito (15 req/min) e impraticavel para o volume
# desta avaliacao. gpt-5-nano (OpenAI) e mais barato que os 3 modelos
# comparados ($0,05/$0,40 por milhao de tokens) e usa uma chave ja
# configurada -- DEEPEVAL_EVAL_PROVIDER=openai usa o caminho nativo do
# DeepEval (string crua), sem precisar do wrapper deepeval.models.
# Para usar Gemini de novo (com faturamento ativado, sem o limite de 15/min):
# DEEPEVAL_EVAL_MODEL=gemini-3.5-flash-lite / DEEPEVAL_EVAL_PROVIDER=google_genai,
# com GOOGLE_API_KEY preenchida acima.
# ============================================================
DEEPEVAL_EVAL_MODEL=gpt-5-nano
DEEPEVAL_EVAL_PROVIDER=openai
